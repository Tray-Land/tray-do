<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UI-free code shared by the app and its tests: the task list and hit list, pasted-text parsing,
    the saved file format, and the tray badge's pixels. Nothing here may depend on WinUI or Windows APIs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrayDo</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
</Project>
