<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="TrayDo.Views.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    Title="Tray Do">

    <Grid x:Name="PopupRoot" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <!--  Tasks or settings; swapping pages slides the new one in.  -->
        <ContentPresenter x:Name="PageHost">
            <ContentPresenter.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="32" VerticalOffset="0" />
                </TransitionCollection>
            </ContentPresenter.ContentTransitions>
        </ContentPresenter>
    </Grid>
</ex:WindowEx>
